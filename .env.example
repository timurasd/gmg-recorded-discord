# =====================
# Discord Configuration
# =====================

# Discord Bot Token
# Создай приложение на https://discord.com/developers/applications
# В разделе Bot → Reset Token скопируй токен
DISCORD_TOKEN=your_discord_bot_token_here

# ID сервера Discord (Guild ID), где будет работать бот
# Включи Developer Mode в Discord, ПКМ по серверу → Copy Server ID
DISCORD_GUILD_ID=your_guild_id_here

# ID текстового канала Discord для отправки сводок
# ПКМ по каналу → Copy Channel ID
DISCORD_SUMMARY_CHANNEL_ID=your_channel_id_here

# =====================
# Telegram Configuration
# =====================

# Telegram Bot Token от @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Chat ID для отправки результатов
# Напиши боту @userinfobot или используй https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# =====================
# OpenAI (сводка)
# =====================

# Ключ OpenAI для сводки (https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here

# Модель для сводки (по умолчанию gpt-4o-mini -- доли цента за час созвона)
# SUMMARY_MODEL=gpt-4o-mini

# =====================
# Whisper Configuration
# =====================

# Whisper model для локальной транскрипции (tiny, base, small, medium, large-v3)
# Рекомендуется: small (лучше качество для русского)
WHISPER_MODEL=small

# Язык для транскрипции (ru, en, auto)
WHISPER_LANGUAGE=ru

# =====================
# Storage
# =====================

# Папка для временных аудиофайлов
AUDIO_OUTPUT_DIR=./recordings

# Python с установленным faster-whisper
PYTHON_CMD=python3
