# Discord Bot Token
# Создай приложение на https://discord.com/developers/applications
# В разделе Bot → Reset Token скопируй токен
DISCORD_TOKEN=your_discord_bot_token_here

# ID сервера Discord (Guild ID), где будет работать бот
# Включи Developer Mode в Discord, ПКМ по серверу → Copy Server ID
DISCORD_GUILD_ID=your_guild_id_here

# ID текстового канала Discord для отправки сводок
# ПКМ по каналу → Copy Channel ID
DISCORD_SUMMARY_CHANNEL_ID=your_channel_id_here

# Telegram Bot Token от @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Chat ID для отправки результатов
# Напиши боту @userinfobot или используй https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Ollama API URL для генерации сводки
OLLAMA_URL=http://localhost:11434/api/generate

# Имя локальной модели в Ollama для summary
OLLAMA_MODEL=llama3.2

# Whisper API URL (локальный сервер)
# Можно использовать faster-whisper-server или openai-whisper-api
WHISPER_URL=http://localhost:8000/v1/audio/transcriptions

# Whisper model name (если сервер поддерживает выбор модели)
WHISPER_MODEL=large-v3

# Папка для временных аудиофайлов
AUDIO_OUTPUT_DIR=./recordings

# Язык для транскрипции (ru, en, auto)
WHISPER_LANGUAGE=ru
