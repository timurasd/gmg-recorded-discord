# /etc/systemd/system/gmg-discord-recorder.service
# The only way the bot runs (pm2 config removed: two copies with one token
# fought each other and used up Discord's daily login limit, 2026-10-01).
[Unit]
Description=GMG Discord Voice Recorder
After=network.target
# A crash loop must not turn into hundreds of Discord logins a day:
# more than 10 starts in an hour and systemd stops trying.
StartLimitIntervalSec=3600
StartLimitBurst=10

[Service]
Type=simple
User=root
WorkingDirectory=/root/apps/gmg-discord-recorder
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="NODE_ENV=production"
ExecStart=/usr/local/n/versions/node/26.1.0/bin/node --max-old-space-size=512 src/index.js
Restart=always
RestartSec=30
# Let an emergency save finish on stop.
TimeoutStopSec=30
# Whisper runs inside this unit. On 2026-10-21 it grew to 4 GB, the kernel
# OOM-killed it and other services' processes, and systemd then restarted the
# whole bot. Cap the unit so only it hits the wall, and keep the bot running
# when its Whisper child is killed -- it reports the failure in Telegram.
MemoryMax=3500M
OOMPolicy=continue
StandardOutput=append:/var/log/gmg-discord-recorder.log
StandardError=append:/var/log/gmg-discord-recorder.error.log

[Install]
WantedBy=multi-user.target
